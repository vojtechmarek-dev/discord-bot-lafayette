DP_FFMPEG_PATH=
BOT_OWNER_ID=1234567890123456789

# Set to 1 to log discord-player's internal debug stream: which extractor ran,
# whether a fallback was attempted, why a stream was rejected. Chatty, and
# discord-player builds the strings eagerly whenever a listener is attached, so
# leave it off unless you are diagnosing playback.
LAFAYETTE_PLAYER_DEBUG=0

# Where lafayette.db and the legacy JSON files live.
# Defaults to <cwd>/data, which is the repo root in dev and /usr/src/app in Docker.
LAFAYETTE_DATA_DIR=

# SQLite journal mode. WAL unless the data dir is on a filesystem without
# working POSIX locking (NFS/SMB), in which case use TRUNCATE.
LAFAYETTE_SQLITE_JOURNAL_MODE=WAL
