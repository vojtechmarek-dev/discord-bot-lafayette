{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Prague",
  "schedule": [
    "before 6am on monday"
  ],
  "rangeStrategy": "replace",
  "dependencyDashboard": true,
  "prConcurrentLimit": 10,
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "groupName": "runtime dependencies",
      "separateMinorPatch": true
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "dev dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github actions (safe updates)",
      "automerge": true
    },
    {
      "matchPackageNames": [
        "discord.js",
        "@discordjs/voice",
        "discord-player",
        "@discord-player/extractor",
        "@distube/ytdl-core",
        "discord-player-soundcloud",
        "discord-player-spotify",
        "ffmpeg-static"
      ],
      "groupName": "voice and media stack",
      "automerge": false,
      "labels": [
        "dependencies",
        "media"
      ]
    },
    {
      "description": "YouTube extraction breaks whenever YouTube changes SABR/PO-token handling, so these ship as their own PR, off-schedule, ahead of everything else. Grouping them with the rest of the media stack means one blocked sibling holds back the only fix that matters.",
      "matchPackageNames": [
        "discord-player-googlevideo",
        "youtubei.js",
        "googlevideo",
        "bgutils-js",
        "jsdom"
      ],
      "groupName": null,
      "schedule": [
        "at any time"
      ],
      "prPriority": 10,
      "automerge": false,
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "labels": [
        "dependencies",
        "media",
        "youtube-extractor"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "dependencies",
        "major"
      ]
    }
  ]
}
